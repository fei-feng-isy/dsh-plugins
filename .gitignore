# Dependencies and install links
node_modules/
.pnpm-store/

# Build output
lib/
dist/
*.tsbuildinfo
# …except the workspace scripts' SOURCE directory: the `lib/` rule above is about build output, and it
# silently swallowed new files under `scripts/lib/` (the tracked ones predate the rule). Keep the
# negation AFTER the rule, and add a matching one if a future build-output pattern can cover source.
!scripts/lib/
!scripts/lib/**

# Release tarballs (the release/README.md files are tracked source)
release/*.tgz
mem/release/*.tgz
work/release/*.tgz
# …and any STRAY pack artifact, wherever it lands: a `npm pack` / `npm publish` run inside a package
# directory drops `<name>-<version>.tgz` next to that package.json, and it is not ours to track. The
# repository never tracks a tarball (the release/ lines above are the deliberate location, also
# ignored). One stray 0.3.0 tarball did get committed this way once; this rule is why it cannot again.
*.tgz

# Test / tool caches
.vitest/
coverage/
*.log

# Review records: kept in the working tree for reference, deliberately not in the
# repository (they quote internals and go stale as the code moves). They cover the
# WORKSPACE now — base/ and mem/ as well as work/ — so the rule lives here, not in a
# subtree's .gitignore.
docs/review/
