{
  "name": "@avantf/mem-contract",
  "version": "0.1.1",
  "private": true,
  "description": "avantf-mem contracts: single source of config + tool schemas (zod)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@gitee.com:ffeng86/avantf-mem.git",
    "directory": "packages/contract"
  },
  "author": "qunqi.ff"
}
