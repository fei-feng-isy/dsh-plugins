{
  "name": "@avantf/mem",
  "private": true,
  "description": "avantf-mem engine: memory store, knowledge store, ingestion, lifecycle, cross-retrieval router",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "eval:derived:stub": "node scripts/derived_eval.mjs --mode stub",
    "eval:derived:real": "node scripts/derived_eval.mjs --mode real"
  },
  "dependencies": {
    "@avantf/mem-contract": "workspace:*",
    "@avantf/mem-convert": "workspace:*",
    "@avantf/mem-retrieval": "workspace:*",
    "@avantf/mem-provision": "workspace:*",
    "unpdf": "catalog:",
    "yaml": "catalog:"
  },
  "optionalDependencies": {
    "nodejieba": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@gitee.com:ffeng86/avantf-mem.git",
    "directory": "packages/core"
  },
  "author": "qunqi.ff"
}
