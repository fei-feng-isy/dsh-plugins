{
  "name": "@avantf/mem-mcp",
  "private": true,
  "description": "avantf-mem optional MCP server entry (retains MCP capability; default is the native Cordis plugin)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "avantf-mem-mcp": "lib/index.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@avantf/mem": "workspace:*",
    "@avantf/mem-contract": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@gitee.com:ffeng86/avantf-mem.git",
    "directory": "packages/mcp"
  },
  "author": "qunqi.ff"
}
