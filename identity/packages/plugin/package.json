{
  "name": "@avantf/dsh-identity",
  "version": "0.1.0",
  "description": "DSH native Cordis plugin: the harness identity section of the system prompt is replaced by three editable profile files (IDENTITY / SOUL / RULES), with multi-lingual built-in presets and a settings page",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/envinit-bootstrap.js",
    "lib/dsh-build.json",
    "lib/types",
    "lib/assets",
    "README.md",
    "lib/interface-version.json",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.15.0 <23 || >=23.11.0"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "test": "vitest run",
    "prepublishOnly": "node ../../../scripts/prepublish-assert.mjs --package @avantf/dsh-identity && node ../../scripts/pack-plugin.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.2 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": ">=4.4.3 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-scope": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dependencies": {
    "@avantf/dsh-plugin-base": ">=0.3.0 <1.0.0"
  },
  "devDependencies": {
    "@avantf/dsh-plugin-base": ">=0.3.0 <1.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git@gitee.com:ffeng86/dsh-plugins.git",
    "directory": "identity/packages/plugin"
  },
  "author": "qunqi.ff",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}
