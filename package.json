{
  "name": "dsh-plugins",
  "private": true,
  "version": "0.1.0",
  "description": "The @avantf family of DSH plugins in one workspace: base (compat + envinit + kit), mem (@avantf/dsh-mem) and mission (@avantf/dsh-mission). Plugins stay independent; only code and business logic are shared.",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:dsh": "node scripts/build-dsh.mjs",
    "release:check:base": "pnpm -C base/plugin-base release:check",
    "release:check:mem": "pnpm -C mem release:check",
    "release:check:mission": "pnpm -C mission release:check",
    "release:check": "node scripts/release-check.mjs",
    "pack:plugin:mem": "pnpm -C mem pack:plugin",
    "pack:plugin:mission": "pnpm -C mission pack:plugin",
    "guard": "node scripts/boundary-guard.mjs",
    "proof:base-swap": "node scripts/prove-base-swap.mjs",
    "proof:base-swap:mount": "node scripts/prove-base-swap.mjs --mount",
    "version:check": "node scripts/version.mjs check",
    "version:prune": "node scripts/version.mjs prune",
    "version:set": "node scripts/version.mjs set",
    "prepublish:assert": "node scripts/prepublish-assert.mjs",
    "clean": "node scripts/clean.mjs",
    "check:old-dsh": "node scripts/check-old-dsh.mjs",
    "check:dsh-lines": "node scripts/check-dsh-lines.mjs"
  },
  "license": "MIT"
}
